{
  "name": "budget-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:model": "node --import tsx --test tests/**/*.test.ts",
    "build:ios": "npm exec --yes --cache /tmp/npm-cache-eas-build -- eas-cli build --platform ios --profile production --clear-cache",
    "submit:ios": "npm exec --yes --cache /tmp/npm-cache-eas-submit -- eas-cli submit --platform ios --profile production --latest --wait --verbose"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "expo": "~53.0.0",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-haptics": "~14.1.4",
    "expo-pdf-text-extract": "^1.0.1",
    "expo-print": "~14.1.4",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "firebase": "^12.11.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-purchases": "^9.15.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-pdf-text-extract",
          "firebase",
          "pdf-lib",
          "pdfjs-dist",
          "react-native-confetti-cannon",
          "xlsx"
        ]
      }
    }
  }
}
