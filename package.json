{
  "name": "budget-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:model",
    "test:model": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build:ios": "npm exec --yes --cache /tmp/npm-cache-eas-build -- eas-cli build --platform ios --profile production --clear-cache",
    "submit:ios": "npm exec --yes --cache /tmp/npm-cache-eas-submit -- eas-cli submit --platform ios --profile production --latest --wait --verbose"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@types/react": "~19.2.10",
    "expo": "^55.0.0",
    "expo-camera": "~55.0.22",
    "expo-contacts": "~55.0.17",
    "expo-dev-client": "~55.0.38",
    "expo-document-picker": "~55.0.16",
    "expo-file-system": "~55.0.25",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.17",
    "expo-pdf-text-extract": "^1.0.1",
    "expo-print": "~55.0.18",
    "expo-sensors": "~55.0.18",
    "expo-sharing": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "firebase": "^12.11.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-purchases": "^9.15.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "typescript": "~5.9.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-pdf-text-extract",
          "firebase",
          "pdf-lib",
          "pdfjs-dist",
          "react-native-confetti-cannon",
          "xlsx"
        ]
      }
    }
  }
}
